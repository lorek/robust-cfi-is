{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic clean-export receipt",
  "type": "object",
  "required": [
    "export_version",
    "file_count",
    "files",
    "sensitive_data_scan",
    "source_unchanged",
    "tree_sha256"
  ],
  "properties": {
    "export_version": {"const": "clean_export_v1"},
    "file_count": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "sensitive_data_scan": {"const": "PASS"},
    "source_unchanged": {"const": true},
    "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
